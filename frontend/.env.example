# Copy to .env and fill in once your backend is deployed.
# Leave both unset for local dev — Vite's dev-server proxy (see vite.config.js)
# routes /api and /ml to localhost:8000/8001 automatically.

VITE_API_URL=https://your-backend.onrender.com/api
VITE_ML_API_URL=https://your-ml-service.onrender.com
