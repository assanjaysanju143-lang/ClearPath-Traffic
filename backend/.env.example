# Copy this file to .env and fill in your own keys.
# The app runs fine without real keys — it falls back to built-in mock
# routing/geocoding data for Bengaluru so you can develop and demo offline.

# Get a free key at: https://developer.tomtom.com (2500 calls/day free)
TOMTOM_API_KEY=YOUR_TOMTOM_API_KEY

# Optional: HERE Maps alternative
HERE_API_KEY=YOUR_HERE_API_KEY

# Optional: enables real LLM parsing for natural-language route requests
# (/api/routes/smart). Without this, a regex-based fallback handles common
# phrasings — see services/nlu.py.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# App settings
APP_ENV=development
CACHE_TTL_SECONDS=60

# Comma-separated list of frontend URLs allowed to call this API in production.
# Leave as "*" for local dev / quick demos.
# e.g. ALLOWED_ORIGINS=https://clearpath.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=*
